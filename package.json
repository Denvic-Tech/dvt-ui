{
  "name": "dvt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:env": "dotenv -e .env -- vite",
    "build": "node ./scripts/run-tsc-with-ignore.mjs && vite build",
    "commitmsg:check": "node ./scripts/validate-commit-msg.mjs",
    "prepare": "husky",
    "precommit:staged": "lint-staged",
    "prepush:checks": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:gateway": "dotenv -e .env -- openapi-ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/inter": "^5.2.5",
    "@mantine/core": "^8.3.16",
    "@mantine/dates": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.3.1",
    "@mui/x-data-grid": "^7.26.0",
    "@mui/x-date-pickers": "^7.27.0",
    "@mui/x-tree-view": "^8.5.3",
    "@openai/codex-sdk": "^0.53.0",
    "@reduxjs/toolkit": "^2.6.0",
    "@tailwindcss/vite": "^4.2.2",
    "@xyflow/react": "^12.6.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "1.14.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "elkjs": "^0.12.0",
    "express": "^5.1.0",
    "lucide-react": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.0.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.1",
    "react-virtuoso": "^4.18.1",
    "redux-persist": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@hey-api/client-axios": "^0.9.1",
    "@hey-api/openapi-ts": "^0.85.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.56.0",
    "prettier": "^3.5.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.0.9",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.0.18"
  }
